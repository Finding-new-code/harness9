# ===========================================================================
# Harness 9 x Hermes Agent — AI Provider & Environment Configuration Template
# Copy this file to '.env' and fill in your active API keys.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. Primary AI LLM Providers (Choose at least one)
# ---------------------------------------------------------------------------
# OpenRouter (Recommended: single key for Claude, DeepSeek, GPT-4o, Llama)
OPENROUTER_API_KEY=

# OpenAI (GPT-4o, GPT-4o-mini, and OpenAI TTS voice narration)
OPENAI_API_KEY=

# Anthropic (Direct Claude 3.5 Sonnet & Haiku access)
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Groq (Ultra-fast inference)
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# 2. Voiceover & Audio Narration (Optional — has offline fallbacks)
# ---------------------------------------------------------------------------
# ElevenLabs (Studio-grade expressive voiceover)
# Fallbacks: OpenAI TTS (if OPENAI_API_KEY provided) -> Windows SAPI -> Synthetic harmonic WAV
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------------
# 3. Live Web Research & Evidence Search (Optional — has offline presets)
# ---------------------------------------------------------------------------
# Tavily Search API (Factual claim verification and source attribution)
TAVILY_API_KEY=

# Exa Neural Search API
EXA_API_KEY=

# ---------------------------------------------------------------------------
# 4. Visual Media & Stock Footage (Optional — has Wikimedia fallback)
# ---------------------------------------------------------------------------
# Pexels API (Stock footage & photography)
# Fallback: Wikimedia Commons (free, Creative Commons, no key required)
PEXELS_API_KEY=
